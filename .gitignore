# 依赖与构建产物（开发阶段才会出现）
node_modules/
dist/
*.log

# 运行时数据（记忆库与记录是用户数据，不入版本库）
store/
records/

# 本地环境/凭据
.env
*.local

# 操作系统/编辑器
.DS_Store
Thumbs.db

# ── 关于 内部文档/ ────────────────────────────────────────────
# 注意：内部文档/ **必须留在 git 里**（要版本控制），所以这里不能忽略它。
# 它不进插件包/不上传，靠 .npmignore + package.json 的 files 白名单排除。

# 临时探测文件（CDP 调试、截图、脚本）
._cdp/
._*.png
._*.cjs
._*.mjs
._*.txt

# 提交消息临时文件（每次 commit 后删除）
.gitmsg.txt
