{
  "name": "dsh-tag-memory",
  "version": "1.4.4",
  "type": "module",
  "description": "Tag-based long-term memory for DSH agents.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "tag",
    "agent"
  ],
  "author": "marsma-101",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marsma-101/dsh-tag-memory.git"
  },
  "homepage": "https://github.com/marsma-101/dsh-tag-memory#readme",
  "bugs": {
    "url": "https://github.com/marsma-101/dsh-tag-memory/issues"
  },
  "exports": {
    ".": "./index.js",
    "./preset": "./preset/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-tag-memory": "./scripts/install.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "client.*.js",
    "preset/**",
    "lib/**",
    "data/**",
    "scripts/install.mjs",
    "scripts/seed.mjs",
    "scripts/checks.mjs",
    "scripts/verify-install.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "标签字典.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify-install.mjs",
    "install:plugin": "node scripts/install.mjs apply"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
